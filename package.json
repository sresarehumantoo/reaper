{
  "name": "@sresarehumantoo/reaper",
  "version": "0.2.0",
  "description": "Dead code and obfuscation analyzer for JavaScript and TypeScript, with a hardened Docker sandbox for dynamic analysis.",
  "license": "MIT",
  "author": "Owen Pierce <owenpierceee@gmail.com>",
  "homepage": "https://github.com/sresarehumantoo/reaper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sresarehumantoo/reaper.git"
  },
  "bugs": {
    "url": "https://github.com/sresarehumantoo/reaper/issues"
  },
  "keywords": [
    "dead-code",
    "deobfuscation",
    "static-analysis",
    "malware-analysis",
    "javascript",
    "typescript",
    "obfuscator-io",
    "etherhiding",
    "sandbox",
    "security"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "reaper": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js && cp src/analyzers/*.cjs dist/analyzers/",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npx tsc --noEmit && npm test"
  },
  "dependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^7.24.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.2",
    "tldts": "^6.1.86"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
